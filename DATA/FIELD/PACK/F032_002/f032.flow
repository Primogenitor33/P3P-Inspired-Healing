import("f032.bf");
import("P3PHeal.flow");
import("P3PEnums.flow");
import("Bits.flow");

void f032_002_init_hook() {
    //Set Mod Version
    if (TUTORIAL_SAVEPOINT_COMPLETE && !FULL_GAME && !LATE_GAME) {
        P3PHealVersion();
    }
    if (ModeCheck()) {
        f032_002_init_unhooked();
    } else {
        if (FULL_MOON) {
            HealTo1HP();
        }
        P3PHealMain();
    }
}

void save_point_hook() {
    if (ModeCheck()) {
        save_point_unhooked();
    } else {
        P3PClock();
    }
}

void condition_check_hook() {
    if (ModeCheck()) {
        condition_check_unhooked();
    }
    else if (IsDead()) {
        P3PHealing(HSTATE.DEAD);
    } else {
        condition_check_unhooked();
    }
}

void member_return_hook() {
    P3PMemberReturn();
}

//Check if Pre-Shinji Death and if Late Game Mode is Enabled
bool ModeCheck() {
    if ((GET_MONTH() < 10) && (GET_MONTH() > 1) && LATE_GAME) {
        return true;
    }
    else if ((GET_MONTH() == 10) && (GET_DAY_OF_MONTH() <= 4) && LATE_GAME) {
        return true;
    }
    return false;
}
