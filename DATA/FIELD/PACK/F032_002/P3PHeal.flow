import("P3PHeal.msg");

void P3PHealVersion() {
    MSG_HELP(P3PHealWelcome);
    OPEN_MSG_WIN();
    MSG(P3PChooseVersion);
    int selection = SEL(P3PHealVersionSel);
    switch (selection) {
        case 0: //Full Game
            BIT_ON(9994);
            break;
        case 1: //Late Game
            BIT_ON(9993);
            break;
        default:
            break;
    }
    CLOSE_MSG_WIN();
}

void ShowP3PHealTutorial() {
    BIT_ON(9995);
    MSG_HELP(P3PHealTutorial);
}

void P3PClock() {
    OPEN_MSG_WIN();
    MSG(P3PHealClock);
    SEL_CHK_PAD(6, 4);
    int selection = SEL(P3PHealClockSel);
    switch (selection) {
        case 0: //Save
            save_point_unhooked();
            break;
        case 1: //Heal Party
            if (IsPartyDamaged()) {
                P3PHealing(1);
            } else {
                MSG(NoHealing);
            }
            break;
        case 2: //Heal Everyone
            if (IsDamaged()) {
                P3PHealing(2);
            } else {
                MSG(NoHealing);
            }
            break;
        default:
            break;
    }
    CLOSE_MSG_WIN();
}


void P3PHealing(int state) {
    //States
    int PARTY = 1;
    int ALL = 2;
    int DEAD = 3;

    int heal_message[3] = {P3PHeal, P3PHeal, P3PHealDead};
    int healed_message[3] = {P3PHealPartyDone, P3PHealAllDone, P3PHealDeadDone};

    //Stores the current Yen value
    int CurrentYen = GET_YEN();
    
    int CurHP = 0;
    int MaxHP = 0;
    int CurSP = 0;
    int MaxSP = 0;
    int PartyMember;
    int offset = 0;
    int Cost = 0;
    bool isDead = (state == DEAD);

    if(state == PARTY || state == ALL) {
        CurHP = GET_CUR_HP(1);
        MaxHP = GET_TOT_HP(1);
        CurSP = GET_CUR_SP(1);
        MaxSP = GET_TOT_SP(1);
    }
    int start = 0;
    int end = 3;
    if(state == ALL) {
        start = 2; end = 10;
    }
    //Check if Party Member is available, if so then add their stats to the variables
    for (int x = start; x <= end; x++) {
        if(state == ALL) PartyMember = x + 320 - offset;
        else PartyMember = GET_PARTY_ID(x);

        //Skip Fuuka
        if (x == 6) {
            offset = 1;
            continue;
        }

        if(state == DEAD){
            if(GET_CUR_HP(PartyMember) == 0){
                CurHP = (CurHP + GET_CUR_HP(PartyMember));
                MaxHP = (MaxHP + GET_TOT_HP(PartyMember));
            }
            continue;
        }

        if (BIT_CHK(PartyMember) || state == PARTY) {
            CurHP = (CurHP + GET_CUR_HP(PartyMember));
            MaxHP = (MaxHP + GET_TOT_HP(PartyMember));
            CurSP = (CurSP + GET_CUR_SP(PartyMember));
            MaxSP = (MaxSP + GET_TOT_SP(PartyMember));
        }
    }
    
    Cost = GetCost(MaxHP - CurHP, MaxSP - CurSP, isDead);

    OPEN_MSG_WIN();
    //Set the price message variable
    SET_MSG_VAR(0, Cost, 0);
    //Set the current yen message variable
    SET_MSG_VAR(1, CurrentYen, 0);
    MSG(heal_message[state]);
    SEL_CHK_PAD(6, 1);
    int selection = SEL(P3PHealingMenuSel);
    switch (selection) {
        case 0: //Heal
            //compare the values to see if you can afford it
            if (Cost > CurrentYen) {
                MSG(Broke);
                if(state == DEAD) condition_check_unhooked();
            }
            //if you can, remove the money and move on to healing
            else {
                REMOVE_YEN(Cost);
                CLOSE_MSG_WIN();
                switch(state) {
                    case PARTY:
                        P3PPartyRecovery();
                        break;
                    case ALL:
                        P3PDeadRecovery();
                        break;
                    case DEAD:
                        FUNCTION_0093();
                        break;
                    default:
                        break;
                }
                OPEN_MSG_WIN();
                MSG(healed_message[state]);
            }
            break;
        default:
            if(state == DEAD) condition_check_unhooked();
            break;
    }
    CLOSE_MSG_WIN();
}


int GetCost(int hp, int sp, bool isDead) {
    int Multi_LUT[9] = {75, 100, 150, 230, 480, 780, 1500, 3100, 5350};
    int Penalty_LUT[9] = {100, 200, 300, 400, 500, 600, 700, 800, 900};

    int start_months[8] = {4,  5,  6, 7, 8,  9, 10, 11};
    int start_days[8] =   {1, 10, 13, 9, 8, 10,  6,  6};

    int end_months[8] = {5,  6, 7, 8, 9, 10, 11, 12};
    int end_days[8] =   {9, 12, 8, 7, 9,  5,  5, 31};
    int idx = -1;
    int cost = 0;

    for(int i = 0; i < 8; i++){
        if (CHECK_TIME_SPAN(start_months[i], start_days[i], end_months[i], end_days[i])) {
            idx = i;
            break;
        }
    }

    //If none of the above conditions are met, it defaults to the last index
    if (idx == -1) {
        idx = 8;
    }
    
    if(isDead) cost = (((hp / 4) * Multi_LUT[idx]) / 100) + Penalty_LUT[idx];
    else cost = (((hp * Multi_LUT[idx]) / 100) + ((sp * Multi_LUT[idx]) / 10));

    return cost;
}

void P3PPartyRecovery() {
    int PartyMember;
    CALL_BTL_SFX(2, 10);
    //Heals MC's SP to max
    SET_SP(1, GET_TOT_SP(1));
    //Heals MC's HP to max
    SET_HP(1, GET_TOT_HP(1));
    //Heals everyone else
    for (int x = 0; x < 3; x++) {
        //Checks which characters are in party and stores their ID
        PartyMember = GET_PARTY_ID(x);
        //if so, heal them
        if (PartyMember != 0) {
            SET_SP(PartyMember, GET_TOT_SP(PartyMember));
            SET_HP(PartyMember, GET_TOT_HP(PartyMember));
        }
    }
}

void P3PDeadRecovery() {
    int PartyMember;
    int FourthHP;
    //Heals everyone else
    for (int x = 0; x < 3; x++) {
        //Checks which characters are in party and stores their ID
        PartyMember = GET_PARTY_ID(x);
        //if so, heal them
        if (PartyMember != 0) {
            //Only apply to dead members
            if (GET_CUR_HP(PartyMember) == 0) {
                FourthHP = GET_TOT_HP(PartyMember) / 4;
                SET_HP(PartyMember, FourthHP);
            }
        }
    }
}

bool IsPartyDamaged() {
    int PartyMember;

    for (int x = 0; x < 3; x++) {
        PartyMember = GET_PARTY_ID(x);
        if (PartyMember != 0) {
            if ((GET_TOT_SP(PartyMember) > GET_CUR_SP(PartyMember)) || (GET_TOT_HP(PartyMember) > GET_CUR_HP(PartyMember))){
                return true;
            }
        }
    }
    return false;
}

bool IsDamaged() {
    for(int x = 1; x <= 10; x++) {
        if ((GET_TOT_SP(x) > GET_CUR_SP(x)) || (GET_TOT_HP(x) > GET_CUR_HP(x))) {
            return true;
        }
    }
    return false;
}

bool IsDead() {
    for(int x = 1; x <= 10; x++) {
        if (GET_CUR_HP(x) == 0) {
            return true;
        }
    }
    return false;
}

void HealTo1HP() {
    for(int x = 1; x <= 10; x++) {
        if (GET_CUR_HP(x) == 0) {
            SET_HP(x,1);
        }
    }
}

void P3PMemberReturn() {
    int var14 = 0;
    check_party_member();
    BIT_OFF(3568);
    int party_return[9] = {YUKARI_RETURN, AEGIS_RETURN, MITSURU_RETURN, JUNPEI_RETURN, 0, SANADA_RETURN, AMADA_RETURN, ARAGAKI_RETURN, KOROMARU_RETURN};
    int offset = 0;

    for(int i = 0; i < 9; i++) {
        if( i == 4) {
            offset = 1;
            continue;
        }
        if (GET_CUR_HP(i + 2) == 0) {
            BIT_OFF(322 + i - offset);
            OPEN_MSG_WIN();
            MSG(party_return[i]);
            CLOSE_MSG_WIN();
            REMOVE_MEMBER(i + 2);
        }
        if (BIT_CHK(322 + i) == 1) {
          var14 += 1;
        }
    }

    if ((var14 < 3) && (BIT_CHK(3188) == 0)) {
        BIT_ON(3188);
        OPEN_MSG_WIN();
        
        if (BIT_CHK(3123) == 1) {
            if (BIT_CHK(3047) == 1) {
                MSG(HUKA_RETURN_ADVICE_TEST);
            } else {
                MSG(HUKA_RETURN_ADVICE);
            }
        } else if (BIT_CHK(3047) == 1) {
            MSG(MITSURU_RETURN_ADVICE_TE);
        } else {
            MSG(MITSURU_RETURN_ADVICE);
        }
        CLOSE_MSG_WIN();
    }
}

void P3PHealMain() {
    if (BIT_CHK(9995) != 1) {
        ShowP3PHealTutorial();
    }

    int var1;
    int var2;
    
    if (FUNCTION_00D7() == 0) {
        if (BIT_CHK(3581) == 1) {
            end_tutorial_dungeon();
            return;
        }
        if ((BIT_CHK(5043) == 1) && (GET_CNT(8) >= 254)) {
            BIT_ON(3192);
        }

        BIT_OFF(5140);
        gVar37 = GET_FLOOR_ID();
        order_initialize();
        
        if ((BIT_CHK(3106) != 1) && (BIT_CHK(3108) == 1)) {
            condition_check();
        }

        BIT_OFF(3108);
        for(int i = 2; i <= 10; i++) {
            //Skip Fuuka
            if(i == 6) {
                continue;
            }
            FUNCTION_0151(i);
        }
        
        if ((BIT_CHK(4964) == 0) || (BIT_CHK(3175) == 1)) {
            BIT_ON(3176);
        } else {
            BIT_OFF(3176);
        }

    } else if (FUNCTION_00D7() == 2) {
        if (((GET_MONTH() == 4) && (GET_DAY_OF_MONTH() == 20)) && (BIT_CHK(3569) == 0)) {
            BIT_ON(3569);
            BIT_OFF(369);
            MSG_HELP(TUTORIAL_SAVEPOINT);
        } else if (((GET_MONTH() == 3) && (GET_DAY_OF_MONTH() == 10)) && (BIT_CHK(4065) == 0)) {
            debug_mode_member_set();
            return;
        } else if (BIT_CHK(3120) == 1) {
            BIT_OFF(3120);
            OPEN_MSG_WIN();
            
            if (BIT_CHK(3170) == 1) {
                BIT_OFF(3170);
                MSG(MITSURU_HELP_WARNING);
                MSG(MITSURU_WARNING_JOINT);
            }

            MSG(MITSURU_ENTRANCE_HELP);
            CLOSE_MSG_WIN();
            MSG_HELP(ENTRANCE_HELP);
        } else if ((BIT_CHK(3112) == 1) && (CHECK_TIME_SPAN(5, 23, 6, 7) == 1)) {
            BIT_OFF(3112);
            OPEN_MSG_WIN();
            MSG(SANADA_GREET);
            CLOSE_MSG_WIN();
        } else if (BIT_CHK(3110) == 1) {
            BIT_OFF(3110);
            OPEN_MSG_WIN();
            MSG(MITSURU_GREET);
            CLOSE_MSG_WIN();
            MSG_HELP(ENTRANCE_HELP2);
            OPEN_MSG_WIN();
            MSG(HUKA_GREET);
            CLOSE_MSG_WIN();
        }

        if (BIT_CHK(3568) == 1) {
            member_return();
        }

        //Full Heal Party
        //FUNCTION_0093();
    } else if (FUNCTION_00D7() == 3) {
        var1 = FLD_MODEL_FUNCTION_0165(-1, 5);
        var2 = FUNCTION_013A(var1, 0);
        FLD_FUNCTION_0138(var2, 1);
        FUNCTION_0079(var2, 1);

        //Checks for something I have no idea what, but this should hopefully be a little easier to read. Should in theory reduce procedure calls.
        int success = BIT_CHK(3501);
        for(int i = 3504; i <= 3515; i++) {
            if(success == 1) {//exit early if already found
                    break;
            }
            if (BIT_CHK(i) == 1) {
                success = 1;
                break;
            }
        }
        for(int i = 3516; i <= 3535; i++) {
            if(success == 1) {//exit early if already found
                    break;
                }
            if (BIT_CHK(i) == 1) {
                success = 1;
                break;
            }
        }
        if (BIT_CHK(3500) == 1) success = 1;
        if (BIT_CHK(3499) == 1) success = 1;
        if(success == 1) FLD_FUNCTION_0089(var2, 1, 1, 0, 1);    

        var1 = FLD_MODEL_FUNCTION_0165(-1, 3);
        var2 = FUNCTION_013A(var1, 0);
        FLD_FUNCTION_0138(var2, 5);
        FUNCTION_0079(var2, 1);
        
        if (BIT_CHK(3192) == 1) FUNCTION_0079(10247, 1);
        else FUNCTION_0079(10247, 0);
        
        if (BIT_CHK(79) == 1) {
            FUNCTION_0079(10245, 0);
            BIT_OFF(3583);
        } else {
            FUNCTION_0079(10245, 1);
            BIT_ON(3583);
        }
    }
}
